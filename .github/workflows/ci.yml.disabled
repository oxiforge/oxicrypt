# NOTE — workflow paused 2026-05-07.
#
# Disabled by renaming `ci.yml` -> `ci.yml.disabled` while the
# repository's GitHub Actions Free-tier minutes (2000/month for
# private repos) are exhausted. GitHub auto-suspends Actions on
# private repos that exceed quota, but the queued-but-failed runs
# render PRs as red until renamed; renaming the workflow file
# suppresses that.
#
# Local CI parity is preserved by `scripts/git-hooks/pre-push`,
# which runs the same four jobs (fmt, clippy, test, build) on
# every push. The hook activates via the existing
# `git config core.hooksPath scripts/git-hooks` setting that the
# pre-commit hook already relies on.
#
# To re-enable cloud CI: rename this file back to `ci.yml`. The
# pre-push hook should stay as defense-in-depth.

name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: "-D warnings"

jobs:
  fmt:
    name: cargo fmt
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install stable toolchain
        run: rustup toolchain install stable --profile minimal --component rustfmt
      - run: cargo fmt --all -- --check

  clippy:
    name: cargo clippy
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install stable toolchain
        run: rustup toolchain install stable --profile minimal --component clippy
      - uses: Swatinem/rust-cache@v2
      - run: cargo clippy --workspace --all-targets -- -D warnings

  test:
    name: cargo test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install stable toolchain
        run: rustup toolchain install stable --profile minimal
      - uses: Swatinem/rust-cache@v2
      # fips-module's unit tests mutate a single global state, so they
      # must run single-threaded. Other crates are unaffected but a
      # global `--test-threads=1` is the safest workspace-wide default
      # until we introduce per-crate test runners.
      - run: cargo test --workspace -- --test-threads=1

  build:
    name: cargo build (release)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install stable toolchain
        run: rustup toolchain install stable --profile minimal
      - uses: Swatinem/rust-cache@v2
      - run: cargo build --workspace --release
