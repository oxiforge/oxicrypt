# Rust
/target
**/target
Cargo.lock.bak
*.rs.bk

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment / secrets
.env
.env.*
*.pem
*.key

# ACVP session store (acvp-harness submission persistence) — holds
# session-bound access tokens (token.txt) and per-session vector
# prompts/responses. Operational state, never repository content.
acvts-demo/

# Fuzzing / profiling artifacts
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
*.profraw
*.profdata

# Claude auto-memory (session-local, not project data)
.auto-memory/

# Project manifest — lives in the project folder, not the repo.
# Contains internal paths and organizational metadata.
llm-project-manifest.yaml
.worktrees/

# Python bytecode caches — never tracked (a .pyc embeds absolute build paths).
__pycache__/
*.py[cod]
