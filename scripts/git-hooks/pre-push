#!/usr/bin/env bash
# Pre-push hook: the fast half of `.github/workflows/ci.yml`.
#
# CI is the gate of record as of 2026-08-10 — it runs on every pull request and
# on main, it carries the feature matrix this hook structurally cannot (it tests
# default features only), and it cannot be bypassed with --no-verify. This hook
# is the fast pre-flight: failing here is quicker and cheaper than failing in
# cloud CI, and it costs about a minute against a warm target dir.
#
# Gates:
#   1. cargo fmt --all -- --check
#   2. cargo clippy --workspace --all-targets -- -D warnings
#   3. cargo nextest run --workspace           <- OPT-IN, see below
#      cargo test --workspace --doc
#      the release construction guard
#   4. cargo build --workspace --release
#
# Gate 3 runs under cargo-nextest (2026-06-12): nextest executes
# every test in its own process, so oxicrypt-module's global-state
# mutation is isolated per test — the old --test-threads=1
# constraint (and the brief --exclude split that replaced it)
# evaporates entirely; the whole workspace runs at full parallelism
# with per-test process isolation as a bonus hardening. nextest does
# not run doctests, so a separate `cargo test --workspace --doc`
# step keeps doctest coverage identical. The same pair lives in
# ci.yml (installed there via taiki-e/install-action@nextest).
#
# Tag-only pushes skip the four gates:
#   ci.yml triggers on `push: branches: [main]` and pull-request
#   only — tag pushes never run cloud CI. This hook mirrors that:
#   when every pushed ref is under refs/tags/, we exit clean
#   without re-running the gate cycle (which has nothing to
#   validate on a tag push — the underlying commits already
#   passed when they landed on a branch).
#
# Stamp cache (added 2026-06-12):
#   The four-gate cycle costs 40-70 minutes on a 4-core host, and
#   re-running it for a push from an UNCHANGED, already-gated state
#   validates nothing. After all four gates pass, the hook records a
#   digest of the exact gated state — HEAD's tree hash plus the
#   staged+unstaged diff against HEAD — in .git/prepush-gated-states
#   (per-clone, never committed). A later push whose state digest is
#   already recorded skips the gates with an explicit message. ANY
#   change to tracked content produces a new digest and re-gates
#   fully; the cache cannot be fooled without editing the stamp file
#   by hand (equivalent to --no-verify, same trust model). Known
#   limit: untracked files are not part of the digest — a build that
#   depends on an untracked file is already outside ci.yml's world.
#   The file keeps the most recent 32 digests.
#
# nextest is OPT-IN here (2026-08-10):
#
#   [3/4a] cargo nextest run --workspace   <- opt-in, off by default
#   [3/4b] cargo test --workspace --doc    <- always runs
#   [3/4c] the release construction guard  <- always runs
#
# CI became the gate of record on 2026-08-10: it runs the suite sliced four
# ways, isolates oxicrypt-maxwell in its own job, and narrows both by what a
# change touches via scripts/gate-scope.sh. This hook keeps the short set, which
# costs about a minute against a warm target dir and catches the overwhelming
# majority of mistakes before a push.
#
# When this hook says a push "skipped the nextest suite" it means exactly 3a;
# doctests and the release guard ran. Nothing here ever means "no tests ran",
# and no message in this file should be written to suggest it — a future reader
# deciding whether a push was tested must be able to answer from the wording.
#
# To opt in:
#
#     OXICRYPT_PUSH_NEXTEST=full        git push    # the whole suite
#     OXICRYPT_PUSH_NEXTEST=no-maxwell  git push    # without the EA tail
#     OXICRYPT_PUSH_NEXTEST=skip        git push    # the default, stated
#
# The automatic Tier A/B path analysis that used to decide this was deleted with
# the switch. It answered "can this push possibly change a test's verdict?", and
# CI now answers the same question from one file rather than two copies.
#
# Bypass:
#   git push --no-verify
#   Use sparingly — never to get a failing gate out of the way — and
#   always document the reason in the commit body or PR description.
#   A bypass here is always worth stating: it asserts the short gates
#   would have passed, which is a factual claim a reviewer can check
#   against the diff. CI re-runs them either way — but after the push,
#   and the containment checks above have no second chance at all.
#
# Activation:
#   git config core.hooksPath scripts/git-hooks
#   (Same setting the pre-commit hook uses; if pre-commit is
#   already firing for you, this hook is already active.)

set -euo pipefail

export RUSTFLAGS="-D warnings"

# Tag-only push short-circuit. Git pipes one line per pushed ref to
# the pre-push hook on stdin, formatted as:
#   <local ref> <local sha> <remote ref> <remote sha>
# We exit clean if every pushed ref is under refs/tags/. Empty
# stdin (no refs read) falls through to running the gates — the
# safe default for any edge case where git invokes the hook with
# nothing to enumerate.
tag_only=true
saw_ref=false
ref_pairs=()
while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha; do
    saw_ref=true
    if [[ "$remote_ref" != refs/tags/* ]]; then
        tag_only=false
    fi
    ref_pairs+=("$local_sha $remote_sha")
done

# ---------------------------------------------------------------------------
# Private-name containment (#161).
#
# Five tracked files once carried absolute developer-machine paths into this
# repository and nothing detected them — no test, no hook, no CI job — and one
# was a committed .pyc where no text review would have surfaced it.
#
# The generic half (host-path SHAPES) is an ordinary doc-guard test that rides
# `cargo nextest run --workspace`. This is the other half: private NAMES, which
# cannot be spelled in a public repository without leaking the thing they
# protect. A committed pattern would publish the name it exists to suppress and
# would match its own source file, so it could never pass.
#
# The list is therefore per-clone: $OXICRYPT_CONTAINMENT_DENY if set, else
# $GIT_DIR/containment-deny. One extended regex per line; `#` comments and blank
# lines ignored.
#
# This runs after stdin is parsed (it needs the pushed shas) but BEFORE the
# tag-only short-circuit and the stamp cache. Both of those skip the expensive
# cargo gates for states that cannot have changed the build — but a state gated
# before a contributor wrote their deny-list has never been checked against it,
# and a tag push still publishes content. A leak check a cache can skip is not a
# leak check.
#
# It scans the COMMITS BEING PUSHED, not the checked-out tree. `git push
# origin other:main` and a secret added in one commit and removed in the next
# both reach the remote while HEAD's tree is clean.
#
# Known limit: this prevents new leaks in what is pushed. It says nothing about
# what is already in history.
# ---------------------------------------------------------------------------
deny_file="${OXICRYPT_CONTAINMENT_DENY:-$(git rev-parse --git-dir)/containment-deny}"

# The deny-list must not live in the work tree. It holds the private strings; a
# later `git add -A` would commit them, and the self-match that would expose
# that only fires on the NEXT push — after the commit exists.
deny_abs="$(cd "$(dirname "$deny_file")" 2>/dev/null && pwd -P || true)/$(basename "$deny_file")"
work_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
git_dir_abs="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
if [[ -n "$work_top" && "$deny_abs" == "$work_top"/* && "$deny_abs" != "$git_dir_abs"/* ]]; then
    echo "pre-push: FAILED — the deny-list must live outside the work tree." >&2
    echo "  It holds the strings it protects; inside the tree, 'git add -A' commits them." >&2
    echo "  Use \$GIT_DIR/containment-deny (the default) or a path outside the repo." >&2
    exit 1
fi

if [[ ! -f "$deny_file" ]]; then
    # Loud, so an absent list is never mistaken for a pass — but the PATH is not
    # printed. A contributor who set OXICRYPT_CONTAINMENT_DENY to something like
    # ~/clients/<name>/deny.txt would otherwise have that name echoed into
    # scrollback and CI logs by the very check meant to protect it.
    echo "pre-push: private-name check SKIPPED — no deny-list found (path not shown)."
    echo "pre-push:   (opt-in; see CONTRIBUTING.md § Private-name containment)"
else
    # Build the revision set actually being pushed. Scanning HEAD would miss both
    # `git push origin other:main` and an add-then-remove inside the range.
    deny_revs=()
    for pair in "${ref_pairs[@]:-}"; do
        read -r _l _r <<<"$pair"
        [[ "$_l" =~ ^0+$ ]] && continue          # ref deletion pushes no content
        if [[ "$_r" =~ ^0+$ ]]; then
            # New remote ref: bound by what the remote already has.
            base="$(git merge-base "$_l" origin/main 2>/dev/null || true)"
            range=$([[ -n "$base" ]] && echo "$base..$_l" || echo "$_l")
        else
            range="$_r..$_l"
        fi
        rev_count_before="${#deny_revs[@]}"
        while IFS= read -r rev; do
            [[ -n "$rev" ]] && deny_revs+=("$rev")
        done < <(git rev-list "$range" 2>/dev/null || true)
        # An empty range means the remote already has these commits — but the ref
        # is still being published, so scan its tip rather than nothing. Falling
        # back to HEAD here would scan a tree unrelated to what is being pushed.
        if [[ "${#deny_revs[@]}" -eq "$rev_count_before" ]]; then
            deny_revs+=("$_l")
        fi
    done
    # No refs on stdin (manual invocation, edge cases): fall back to HEAD rather
    # than scanning nothing, and say so.
    if [[ "${#deny_revs[@]}" -eq 0 ]]; then
        deny_revs=("HEAD")
        echo "pre-push: private-name check — no pushed revisions enumerated; scanning HEAD."
    fi
    # Bound the work, visibly. A silent cap would read as full coverage.
    if [[ "${#deny_revs[@]}" -gt 200 ]]; then
        echo "pre-push: private-name check — ${#deny_revs[@]} revisions in range; scanning the newest 200."
        deny_revs=("${deny_revs[@]:0:200}")
    fi

    # Positive control, with the SAME flags as the real scan (notably -a). A
    # control that excludes binaries certifies nothing about a scan that includes
    # them, and a grep matching nothing looks exactly like a grep finding nothing.
    if ! git grep -a -q -E -e 'oxicrypt' "${deny_revs[@]}" -- . 2>/dev/null; then
        echo "pre-push: FAILED — containment scanner is broken." >&2
        echo "  The positive control was not found in the pushed revisions, so a" >&2
        echo "  clean result from this scanner would mean nothing." >&2
        exit 1
    fi

    deny_hits=0
    deny_seen=0
    deny_ran=0
    deny_lineno=0
    while IFS= read -r pattern || [[ -n "$pattern" ]]; do
        deny_lineno=$((deny_lineno + 1))
        pattern="${pattern%$'\r'}"          # a CRLF list would be silently inert
        [[ "$pattern" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        deny_seen=$((deny_seen + 1))
        # Capture the status explicitly. `git grep` exits 128 on an invalid ERE —
        # which an `if` reads as "no match", so a hand-written typo would disable
        # that pattern forever while the hook reported success. 0 = matched,
        # 1 = clean, anything else = the pattern never ran.
        set +e
        matches="$(git grep -a -l -E -e "$pattern" "${deny_revs[@]}" -- . 2>/dev/null)"
        rc=$?
        set -e
        if [[ "$rc" -ge 2 ]]; then
            echo "pre-push: FAILED — deny-list line $deny_lineno is not a valid regex." >&2
            echo "  git grep exited $rc, so that pattern was never applied." >&2
            echo "  (The line's text is not printed — it is the private string.)" >&2
            exit 1
        fi
        deny_ran=$((deny_ran + 1))
        # Paths too, not just content. A private name can appear ONLY in a
        # filename — docs/<client>-migration.md — which a content grep never sees.
        path_hits=""
        for rev in "${deny_revs[@]}"; do
            if hits="$(git ls-tree -r --name-only "$rev" 2>/dev/null | grep -E -e "$pattern" || true)"; then
                [[ -n "$hits" ]] && path_hits+="${rev}: ${hits}"$'\n'
            fi
        done
        if [[ -n "$path_hits" ]]; then
            deny_hits=$((deny_hits + 1))
            echo "pre-push: FAILED — deny-list line $deny_lineno matched a PATH." >&2
            echo "$path_hits" | head -20 | sed 's/^/    /' >&2
        fi
        if [[ "$rc" -eq 0 ]]; then
            deny_hits=$((deny_hits + 1))
            echo "pre-push: FAILED — deny-list line $deny_lineno matched." >&2
            # Files are named; the pattern and the matched text never are.
            # Echoing them would write the private string into scrollback, CI
            # logs and shell history — reproducing the leak while reporting it.
            echo "$matches" | head -20 | sed 's/^/    /' >&2
            extra=$(($(echo "$matches" | wc -l) - 20))
            [[ "$extra" -gt 0 ]] && echo "    (+$extra more)" >&2
        fi
    done < "$deny_file"

    if [[ "$deny_hits" -gt 0 ]]; then
        echo "  Remove the content, then push again." >&2
        echo "  To locate it locally without this hook echoing it:" >&2
        echo "    git grep -n -E -f <(sed -n '<LINE>p' \"\$deny_file\")" >&2
        exit 1
    fi
    echo "pre-push: private-name check passed ($deny_ran/$deny_seen pattern(s) applied over ${#deny_revs[@]} revision(s))."
fi

# ---------------------------------------------------------------------------
# Security Policy containment.
#
# `doc_guard::tests::the_security_policy_is_not_in_the_public_tree` is the real
# check, but it only runs inside `cargo nextest run --workspace` — and as of
# 2026-08-10 nextest does not run here at all unless asked. So restoring the
# withheld Security Policy is a push that skips the guard protecting against it:
#
#     cp <policy> docs/security-policy/ && git commit && git push
#
# pre-commit does not run doc-guard, nextest is opt-in, and a 3,560-line
# certification-package document reaches the remote.
#
# This duplicate was already load-bearing when the old Tier A escape merely
# skipped nextest for pushes touching no Rust. Making nextest opt-in did not
# weaken it — it made it the ONLY local guard against publishing that document,
# for every push rather than for some. Deleting it because "CI runs doc-guard"
# would be a mistake of a specific kind: CI runs after the push, and publication
# is the one direction that cannot be undone.
#
# So it is duplicated here, on the same terms and in the same position as the
# deny-list scan above: before the tag-only short-circuit and before the stamp
# cache, scanning the COMMITS BEING PUSHED rather than the checked-out tree. The
# reasoning is the one already written for the deny-list — a leak check a cache
# can skip is not a leak check — and publication is the one direction that cannot
# be undone.
#
# Same known limit as the deny-list: this prevents new leaks in what is pushed. It
# says nothing about what is already in history.
# ---------------------------------------------------------------------------
# The detector phrase, and the tracked files that legitimately carry it: the
# doc-guard test and this hook. Both are detectors, not policy prose. These
# mirror the constants in tools/doc-guard/src/lib.rs; the phrase is already
# public in that file, so naming it here publishes nothing new. Missing this
# file from the exempt set makes every clean push fail — the containment guard
# on the other side caught exactly that when this scan was added.
sp_phrase='the probability that a healthy source producing exactly its claimed min-entropy H'
sp_exempt_paths=(':!tools/doc-guard/src/lib.rs' ':!scripts/git-hooks/pre-push')

sp_revs=()
for pair in "${ref_pairs[@]:-}"; do
    read -r _l _r <<<"$pair"
    # An empty local sha is not a revision. It arises when this loop runs over
    # an empty ref_pairs array — `"${ref_pairs[@]:-}"` yields one empty element
    # — which is what a manual invocation with nothing on stdin produces. The
    # empty string then fell through to the fallback below and was appended as
    # if it were a revision, so the array was never empty, the HEAD fallback
    # never fired, and the positive control failed against a nonexistent rev.
    # The hook could not be run by hand at all (#198).
    [[ -z "$_l" || "$_l" =~ ^0+$ ]] && continue
    if [[ "$_r" =~ ^0+$ ]]; then
        base="$(git merge-base "$_l" origin/main 2>/dev/null || true)"
        range=$([[ -n "$base" ]] && echo "$base..$_l" || echo "$_l")
    else
        range="$_r..$_l"
    fi
    before="${#sp_revs[@]}"
    while IFS= read -r rev; do
        [[ -n "$rev" ]] && sp_revs+=("$rev")
    done < <(git rev-list "$range" 2>/dev/null || true)
    [[ "${#sp_revs[@]}" -eq "$before" ]] && sp_revs+=("$_l")
done
if [[ "${#sp_revs[@]}" -eq 0 ]]; then
    if [[ "$saw_ref" == "true" ]]; then
        # Refs were supplied but enumerated to nothing: an up-to-date push, or
        # a deletion. There is no tree being published, so there is nothing to
        # contain — and the control would fail for want of anything to find,
        # which reads as a broken guard rather than an empty push (#198).
        echo "pre-push: security-policy containment — no revisions to scan (branch up to date)."
        sp_revs=()
    else
        sp_revs=("HEAD")
        echo "pre-push: security-policy containment — no pushed revisions enumerated; scanning HEAD."
    fi
fi
if [[ "${#sp_revs[@]}" -gt 200 ]]; then
    echo "pre-push: security-policy containment — ${#sp_revs[@]} revisions in range; scanning the newest 200."
    sp_revs=("${sp_revs[@]:0:200}")
fi

# An empty revision set must not reach the scan. Under `set -u` the array
# expands to no arguments at all, which silently turns a history scan into a
# working-tree scan — a different check wearing the same name, and one that
# would report success for a push carrying nothing.
if [[ "${#sp_revs[@]}" -eq 0 ]]; then
    echo "pre-push: security-policy containment — nothing to scan; skipping."
else

# Positive control, with the same flags as the real scan. The exempt file carries
# the phrase in every revision, so a scanner that finds nothing here is broken —
# and a broken scanner's clean result is indistinguishable from containment.
if ! git grep -a -q -F -e "$sp_phrase" "${sp_revs[@]}" -- . 2>/dev/null; then
    echo "pre-push: FAILED — security-policy containment scanner is broken." >&2
    echo "  The detector phrase was not found in the pushed revisions, so a clean" >&2
    echo "  result from this scan would mean nothing. Either the guards no longer" >&2
    echo "  carry it, or the scan is not reaching the tree." >&2
    exit 1
fi

sp_named="$(for rev in "${sp_revs[@]}"; do
    git ls-tree -r --name-only "$rev" 2>/dev/null \
        | grep -E '(^|/)(security-policy|jent-concept-mapping)\.md$' | sed "s|^|${rev}: |" || true
done)"
sp_phrased="$(git grep -a -l -F -e "$sp_phrase" "${sp_revs[@]}" -- . "${sp_exempt_paths[@]}" 2>/dev/null || true)"

if [[ -n "$sp_named" || -n "$sp_phrased" ]]; then
    {
        echo "pre-push: FAILED — a withheld document is being pushed."
        echo "  The Security Policy and its annexes are withheld from this repository by"
        echo "  design; see docs/security-policy/README.md. They belong in the private"
        echo "  policy repository."
        [[ -n "$sp_named" ]]   && { echo "  Withheld files by name:"; echo "$sp_named"   | head -20 | sed 's/^/    /'; }
        [[ -n "$sp_phrased" ]] && { echo "  Files carrying policy prose:";    echo "$sp_phrased" | head -20 | sed 's/^/    /'; }
        echo "  Remove it from the commits being pushed, then push again."
    } >&2
    exit 1
fi
echo "pre-push: security-policy containment passed (${#sp_revs[@]} revision(s))."
fi

# ---------------------------------------------------------------------------
# Publishability of internal dependencies (#196).
#
# Deliberately placed here, above the tag-only short-circuit and the stamp
# cache: it costs a fraction of a second, and a release tag is exactly the push
# that most needs it — the version literals it checks are what `bump-version.sh`
# has just rewritten. Skipping it for a cached state would also mean a manifest
# edit that changes no Rust never gets checked.
#
# Not part of the four gates because it is not a compile or test step; it reads
# the workspace's declared structure through `cargo metadata --offline`.
# ---------------------------------------------------------------------------
if [[ ! -x scripts/check-internal-deps.sh ]]; then
    echo "pre-push: FAILED — scripts/check-internal-deps.sh is missing or not executable." >&2
    echo "pre-push:   A guard that silently disappears is the failure it exists to prevent." >&2
    exit 1
fi

# Scan the COMMITS BEING PUSHED, not the checked-out tree — the same discipline
# as the two containment checks above, and for the same reason: `git push
# origin other:main` and `git push origin v1.2.3` both send a tree that is not
# HEAD, so a working-tree check would validate whatever happens to be checked
# out and pass a defect straight to the remote.
#
# Each pushed tip is examined in a throwaway detached worktree. `cargo metadata`
# needs a real directory to read, and a worktree is cheap because nothing is
# built — no target dir is touched.
check_deps_wt=""
cleanup_check_deps_wt() {
    [[ -n "$check_deps_wt" && -d "$check_deps_wt" ]] || return 0
    git worktree remove --force "$check_deps_wt" >/dev/null 2>&1 || rm -rf "$check_deps_wt"
    check_deps_wt=""
}
trap cleanup_check_deps_wt EXIT

if [[ "$saw_ref" == "true" ]]; then
    dep_checked=0
    for pair in "${ref_pairs[@]}"; do
        dep_sha="${pair%% *}"
        [[ "$dep_sha" =~ ^0+$ ]] && continue   # ref deletion — nothing to gate

        # A revision predating this guard has nothing to check. Skipping is
        # correct, and it is announced so the skip is never mistaken for a pass.
        if ! git cat-file -e "$dep_sha:scripts/check-internal-deps.sh" 2>/dev/null; then
            echo "pre-push: internal-dependency check SKIPPED for ${dep_sha:0:12} — the revision predates the guard."
            continue
        fi

        check_deps_wt="$(mktemp -d)"
        if ! git worktree add -q --detach "$check_deps_wt" "$dep_sha" 2>/dev/null; then
            echo "pre-push: FAILED — could not create a worktree for ${dep_sha:0:12}; the check could not run." >&2
            exit 1
        fi
        if ! "$check_deps_wt/scripts/check-internal-deps.sh"; then
            echo "pre-push: FAILED — internal dependencies are not publishable in ${dep_sha:0:12}." >&2
            exit 1
        fi
        cleanup_check_deps_wt
        dep_checked=$((dep_checked + 1))
    done
    echo "pre-push: internal-dependency check passed ($dep_checked revision(s))."
else
    # No refs on stdin — a manual invocation. Fall back to the working tree so
    # the hook can be exercised by hand, and say which tree was read.
    echo "pre-push: internal-dependency check — no pushed refs enumerated; checking the working tree."
    if ! scripts/check-internal-deps.sh; then
        echo "pre-push: FAILED — internal dependencies are not publishable." >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# LAMA manifest conformance (#175).
#
# Placed here for the same reasons as the internal-dependency check above: it
# costs a fraction of a second, it reads the revisions being pushed rather than
# the working tree, and it sits above the tag-only short-circuit and the stamp
# cache so a docs-only push cannot slip past it. A manifest edit touches no Rust
# and would otherwise be exactly the push that runs the least.
#
# pre-commit already requires the manifest to be STAGED alongside a public-item
# change. It has never checked that the content conforms, so a manifest could be
# dutifully updated into narrative prose that defeats the purpose of having one.
#
# Not part of the four gates: it is not a compile or test step, and it runs a
# TypeScript linter rather than cargo.
# ---------------------------------------------------------------------------
if [[ ! -x scripts/check-lama-manifests.sh ]]; then
    echo "pre-push: FAILED — scripts/check-lama-manifests.sh is missing or not executable." >&2
    echo "pre-push:   A guard that silently disappears is the failure it exists to prevent." >&2
    exit 1
fi

# The linter needs a bun runtime, which a Rust contributor has no reason to
# have installed. Blocking every such push on it would be disproportionate;
# skipping silently would let a non-conformant manifest through unremarked. So
# the answer depends on what is being pushed: a push that touches no manifest
# is announced as skipped, and a push that touches one is refused, because that
# is precisely the push this check exists for.
# `grep -q` is deliberately avoided below. Under `pipefail` it exits on its
# first match, the upstream `git diff` takes SIGPIPE, and the pipeline reports
# 141 — so a successful match can read as a failed test, which here would mean
# concluding no manifest was touched precisely when one was. The file list is
# captured first and matched without a pipeline.
lama_re='(^|/)(lama\.yaml|llm-api[a-z-]*\.yaml)$'
lama_touched=false
if [[ "$saw_ref" == "true" ]]; then
    for pair in "${ref_pairs[@]}"; do
        read -r _l _r <<<"$pair"
        [[ -z "$_l" || "$_l" =~ ^0+$ ]] && continue
        lama_files=''
        lama_ok=true
        if [[ "$_r" =~ ^0+$ ]]; then
            base="$(git merge-base "$_l" origin/main 2>/dev/null || true)"
            if [[ -n "$base" ]]; then
                lama_files="$(git diff --name-only "$base..$_l" 2>/dev/null)" || lama_ok=false
            else
                # No merge base — a new or orphan branch. Two wrong answers to
                # avoid here, both of which return a truthful reply to the
                # wrong question and so cannot be caught by the fail-closed
                # guard below.
                #
                # `git diff <sha>` compares that commit against the WORKING
                # TREE, and returns empty whenever they agree.
                #
                # `git diff-tree <sha>` compares the TIP against its parents,
                # so a branch whose manifest changed in its first commit of
                # three reports nothing — and a merge commit tip prints nothing
                # at all.
                #
                # The question is what the whole push carries, so enumerate
                # every commit reachable from the tip that no remote already
                # has. With no remotes that is the entire history, which is
                # correct: all of it is new to the remote.
                lama_files="$(git log --name-only --pretty=format: "$_l" --not --remotes 2>/dev/null)" || lama_ok=false
            fi
        else
            lama_files="$(git diff --name-only "$_r..$_l" 2>/dev/null)" || lama_ok=false
        fi
        # Fail closed. If the range could not be computed — a shallow clone, or
        # a remote sha this clone does not have — the honest answer is "assume
        # a manifest is in play", because the alternative silently downgrades a
        # refusal to a skip.
        if [[ "$lama_ok" != "true" ]]; then
            lama_touched=true
            break
        fi
        if [[ -n "$lama_files" ]] && printf '%s\n' "$lama_files" | grep -Ec "$lama_re" >/dev/null; then
            lama_touched=true
            break
        fi
    done
else
    lama_files="$(git diff --name-only HEAD 2>/dev/null || true)"
    if [[ -n "$lama_files" ]] && printf '%s\n' "$lama_files" | grep -Ec "$lama_re" >/dev/null; then
        lama_touched=true
    fi
fi

if ! command -v bun >/dev/null 2>&1; then
    if [[ "$lama_touched" == "true" ]]; then
        echo "pre-push: FAILED — this push edits a LAMA manifest and bun is not installed." >&2
        echo "pre-push:   The conformance linter cannot run, so the manifest cannot be" >&2
        echo "pre-push:   checked. Install bun (https://bun.sh) and push again." >&2
        exit 1
    fi
    echo "pre-push: LAMA conformance SKIPPED — bun is not installed and no manifest is being pushed."
else
    if [[ "$saw_ref" == "true" ]]; then
        lama_checked=0
        for pair in "${ref_pairs[@]}"; do
            lama_sha="${pair%% *}"
            [[ "$lama_sha" =~ ^0+$ ]] && continue   # ref deletion — nothing to gate

            # A revision predating this guard has nothing to check. Skipping is
            # correct, and it is announced so the skip is never read as a pass.
            #
            # But absence of the guard has two causes and only one is benign.
            # A revision that DELETES it is also missing it, and would earn the
            # same reassuring "predates the guard" line while removing the check
            # and passing. So distinguish them: if the guard exists on the
            # branch this revision descends from, its absence here is a removal,
            # not history.
            if ! git cat-file -e "$lama_sha:scripts/check-lama-manifests.sh" 2>/dev/null; then
                guard_base="$(git merge-base "$lama_sha" origin/main 2>/dev/null || true)"
                if [[ -z "$guard_base" ]]; then
                    # Without a merge base the two causes cannot be told apart,
                    # and the benign reading is the dangerous one: it prints a
                    # reassuring line and lets a guard-removing push through.
                    # origin/main is absent on a --single-branch clone, a
                    # remote not named origin, or a default branch not named
                    # main, so this is reachable rather than theoretical.
                    # "Cannot decide" is reported as a refusal, not a skip.
                    echo "pre-push: FAILED — ${lama_sha:0:12} does not carry scripts/check-lama-manifests.sh," >&2
                    echo "pre-push:   and no merge base with origin/main is available to tell whether" >&2
                    echo "pre-push:   that is a revision predating the guard or one removing it." >&2
                    echo "pre-push:   Fetch origin/main so the two can be distinguished." >&2
                    exit 1
                fi
                if git cat-file -e "$guard_base:scripts/check-lama-manifests.sh" 2>/dev/null; then
                    echo "pre-push: FAILED — ${lama_sha:0:12} removes scripts/check-lama-manifests.sh." >&2
                    echo "pre-push:   The guard exists at the merge base, so this is a deletion" >&2
                    echo "pre-push:   rather than a revision that predates it. Restore it, or" >&2
                    echo "pre-push:   remove the hook stage in the same change." >&2
                    exit 1
                fi
                echo "pre-push: LAMA conformance SKIPPED for ${lama_sha:0:12} — the revision predates the guard."
                continue
            fi
            if ! scripts/check-lama-manifests.sh "$lama_sha"; then
                echo "pre-push: FAILED — LAMA manifests are not conformant in ${lama_sha:0:12}." >&2
                exit 1
            fi
            lama_checked=$((lama_checked + 1))
        done
        if [[ "$lama_checked" -eq 0 ]]; then
            # Every revision was skipped. Reporting that as "passed" would put
            # the word next to a count of zero and read as success at a glance,
            # which is how a gate that checked nothing gets mistaken for one
            # that approved everything.
            echo "pre-push: LAMA conformance — no revisions checked (all skipped)."
        else
            echo "pre-push: LAMA conformance passed ($lama_checked revision(s))."
        fi
    else
        echo "pre-push: LAMA conformance — no pushed refs enumerated; checking the working tree."
        if ! scripts/check-lama-manifests.sh; then
            echo "pre-push: FAILED — LAMA manifests are not conformant." >&2
            exit 1
        fi
    fi
fi

if [[ "$saw_ref" == "true" && "$tag_only" == "true" ]]; then
    echo "pre-push: tag-only push detected — skipping four-gate cycle."
    exit 0
fi

# Stamp cache: digest of the exact state the gates would test —
# HEAD's tree plus any staged/unstaged modifications to tracked
# files. If this digest already passed, skip the cycle.
git_dir="$(git rev-parse --git-dir)"
stamp_file="$git_dir/prepush-gated-states"
state_digest="$(
    {
        git rev-parse 'HEAD^{tree}'
        git diff HEAD
    } | sha256sum | cut -d' ' -f1
)"

if [[ -f "$stamp_file" ]] && grep -qx "$state_digest" "$stamp_file"; then
    echo "pre-push: state ${state_digest:0:12}… already passed all four gates — skipping (stamp cache)."
    echo "pre-push: any change to tracked files re-gates fully; rm $stamp_file to force."
    exit 0
fi

# --- nextest is OPT-IN locally (2026-08-10).
#
# CI is the gate of record. It runs the suite sliced four ways, isolates
# oxicrypt-maxwell in its own job, and decides which of those a change needs via
# scripts/gate-scope.sh -- the same fail-closed rule this hook used to compute
# inline, now in one file with one copy.
#
# What stays here is the short set: fmt, clippy over all targets, doctests, the
# release-build jitter guard, the release build, and the three checks above this
# point that cost fractions of a second. Those catch the overwhelming majority of
# mistakes before a push, which is the whole reason a local hook exists.
#
# What left is the 30-to-40 minutes of nextest, which bought a second opinion on
# tests CI now runs anyway. Measured 2026-08-10: sliced four ways the suite
# settles in ~10 minutes on a runner, and maxwell's EA-anchored tail -- ~20
# minutes, one test of which exceeds 1300s -- runs only when its closure changes.
#
# To run it here anyway, before pushing or while iterating:
#
#     OXICRYPT_PUSH_NEXTEST=full        git push    # the whole suite
#     OXICRYPT_PUSH_NEXTEST=no-maxwell  git push    # without the EA tail
#     cargo nextest run --profile quick             # no push involved
#
# The Tier A and Tier B path analysis that used to live here is deleted rather
# than left inert. Its inputs -- the Rust-relevance regex, the maxwell closure,
# the workspace inventory -- now have exactly one home in scripts/gate-scope.sh,
# and a second, stale copy of a fail-closed rule is worse than no copy at all.
run_nextest=false
nextest_scope=""
skip_reason="nextest is opt-in locally; CI is the gate of record"
scope_reason=""

# --- Explicit operator override. Announced loudly. `full` is how nextest is
# asked for at all now; skip/no-maxwell write no stamp, and only `full` runs
# everything a stamp claims. An unrecognised value is refused
# rather than silently ignored — a typo that fell through to the default
# would look exactly like the override having been honoured.
case "${OXICRYPT_PUSH_NEXTEST:-}" in
    "")          ;;
    skip)        run_nextest=false; nextest_scope=""; scope_reason=""
                 skip_reason="OXICRYPT_PUSH_NEXTEST=skip (operator choice)" ;;
    no-maxwell)  run_nextest=true;  nextest_scope="-E not package(oxicrypt-maxwell)"
                 scope_reason="OXICRYPT_PUSH_NEXTEST=no-maxwell (operator choice)" ;;
    full)        run_nextest=true;  nextest_scope=""; scope_reason=""; skip_reason="" ;;
    *)           echo "pre-push: FAILED — OXICRYPT_PUSH_NEXTEST='${OXICRYPT_PUSH_NEXTEST}' is not one of skip|no-maxwell|full." >&2
                 exit 1 ;;
esac

# One decision line, printed after everything that could change it. It names
# what nextest will do and why, in that order, so a reader of scrollback
# never has to work out which of two announcements won.
if [[ "$run_nextest" == "false" ]]; then
    echo "pre-push: nextest will be SKIPPED — ${skip_reason}. Every other gate, doctests and the release guard included, still runs."
elif [[ -n "$nextest_scope" ]]; then
    echo "pre-push: nextest will run WITHOUT oxicrypt-maxwell — ${scope_reason}."
    echo "pre-push:   (maxwell carries the EA-anchored tail; all of nextest runs when its inputs change)"
elif [[ -n "${scope_reason:-}" ]]; then
    echo "pre-push: nextest will run IN FULL — ${scope_reason}."
else
    echo "pre-push: nextest will run IN FULL."
fi

echo "pre-push [1/4]: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "pre-push [2/4]: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

if [[ "$run_nextest" == "true" ]]; then
    if [[ -n "$nextest_scope" ]]; then
        echo "pre-push [3/4a]: cargo nextest run --workspace -E 'not package(oxicrypt-maxwell)'"
        nextest_out=$(cargo nextest run --workspace -E 'not package(oxicrypt-maxwell)' 2>&1) || {
            echo "$nextest_out" >&2; exit 1; }
        echo "$nextest_out"
        # Fail closed on a filter that selected nothing: a nextest expression
        # that matches no test exits 0, which reads exactly like a pass.
        grep -Eq "[1-9][0-9]* tests run" <<<"$nextest_out" \
            || { echo "pre-push [3/4a] FAILED: the scoped test run selected no tests" >&2; exit 1; }
    else
        echo "pre-push [3/4a]: cargo nextest run --workspace"
        cargo nextest run --workspace
    fi
else
    echo "pre-push [3/4a]: SKIPPED — ${skip_reason:-no Rust-relevant paths in this push}."
fi

echo "pre-push [3/4b]: cargo test --workspace --doc"
cargo test --workspace --doc

# 3c (2026-07-03): the entropy construction/elision live guard in RELEASE
# profile. nextest runs debug, and the release-optimized timer-read/workload
# loops behave differently on live hardware — a debug-only gate hid a
# release-only jitter-source construction refusal (#124, found by the first
# pilot-collection run). Deliberately runs ONLY the construction-stage guard
# (release_guard_delta_variance_persists): the full-pipeline live test rolls
# the startup health tests, whose verdict on a virtualized counter's pinned
# low bits is load-dependent — correct behavior, wrong thing to gate a push
# on. Bare-metal hosts run the full pipeline via the collect/pilot path.
echo "pre-push [3/4c]: cargo test --release -p oxicrypt-entropy --features raw-counter release_guard"
guard_out=$(cargo test --release -p oxicrypt-entropy --features raw-counter release_guard 2>&1)
echo "$guard_out"
# Fail closed on a zero-match filter: `cargo test <filter>` exits 0 with
# "0 tests run" if the guard test is renamed or feature-moved, which would
# silently disable this gate.
echo "$guard_out" | grep -Eq "test result: ok\. [1-9][0-9]* passed" \
    || { echo "pre-push [3/4c] FAILED: release_guard matched no passing tests" >&2; exit 1; }

echo "pre-push [4/4]: cargo build --workspace --release"
cargo build --workspace --release

# Record the gated state; keep the most recent 32 digests.
#
# ONLY a full run stamps. The stamp is read as "all four gates passed on
# this exact state", and a later push that hits it skips everything — so a
# reduced run must never be able to satisfy one. A tier-A or tier-B pass is
# real, and it is also narrower than what the stamp claims.
if [[ "$run_nextest" == "true" && -z "$nextest_scope" ]]; then
    { [[ -f "$stamp_file" ]] && cat "$stamp_file"; echo "$state_digest"; } \
        | tail -32 > "$stamp_file.tmp" && mv "$stamp_file.tmp" "$stamp_file"
    echo "pre-push: all four gates passed (state ${state_digest:0:12}… stamped)."
elif [[ "$run_nextest" == "true" ]]; then
    echo "pre-push: gates passed; nextest ran without oxicrypt-maxwell (no stamp written)."
else
    echo "pre-push: gates passed; nextest was skipped (doctests and the release guard ran) (no stamp written)."
fi
